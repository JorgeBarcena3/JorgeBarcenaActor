*.pem
*.key
*.crt

# --- Archivos temporales de pruebas ---
coverage/
.nyc_output/

# --- Imágenes originales pesadas (Opcional) ---
# Si tienes una carpeta "RAW" con fotos de 50MB que luego optimizas, 
# descomenta la siguiente línea para no subir las pesadas:
# images/Luz/RAW/
contacto/