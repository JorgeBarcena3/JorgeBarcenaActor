# --- Dependencias de Node.js ---
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log
package-lock.json # OPCIONAL: Quita esta línea si quieres asegurar versiones exactas (recomendado mantenerlo en git, pero a veces da conflictos)

# --- Variables de Entorno y Secretos (MUY IMPORTANTE) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Archivos de Sistema Operativo ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- Logs del Servidor (Backend) ---
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Archivos de Build (Si usas compiladores en el futuro) ---
dist/
build/

# --- Seguridad / Certificados SSL ---
