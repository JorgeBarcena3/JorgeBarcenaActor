# ==============================================================================
# Variables de Entorno — jorgebarcena.es (Portfolio Actor)
# ==============================================================================

# Puerto de escucha del servicio (interno en Docker o local)
PORT=6666

# Entorno de ejecución (production / development)
NODE_ENV=production

# Nombres para contenedores Docker
CONTAINER_NAME=jorgebarcena_actor

# ==============================================================================
# Notificaciones a Telegram
# ==============================================================================
# Token del bot proporcionado por @BotFather (ej. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# Chat ID o ID de canal/grupo donde recibirás las alertas (ej. 123456789 o -100123456789)
# Puedes obtener tu Chat ID enviando un mensaje a @userinfobot o @GetIDsBot
TELEGRAM_CHAT_ID=

# Opcional: ID del tema/hilo en grupos de Telegram con topics activados
TELEGRAM_THREAD_ID=
